<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded into glassgram.exe by build.rs. A plain, honest manifest: no elevation, the Windows
     versions it runs on. Unsigned exes without one look more suspicious to antivirus heuristics. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="petro-pixel.Glassgram" version="1.0.0.0" processorArchitecture="*"/>
  <description>Glassgram, a Telegram client</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
